{
  "expo": {
    "name": "VelociRoute",
    "slug": "velociroute",
    "owner": "sandaru71",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "exp",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.velociroute"
    },
    "android": {
      "package": "com.velociroute"
    }
  }
}